{
  "name": "@zensen/form-validators",
  "version": "1.1.1",
  "license": "MIT",
  "description": "Validators for form-service",
  "main": "build/index.js",
  "module": "build/index.esm.js",
  "unpkg": "build/index.umd.js",
  "jsdelivr": "build/index.umd.js",
  "files": [
    "build"
  ],
  "author": "Travis True <travis.true08@gmail.com> (http://www.travistrue.io)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zensen-web/form-validators.git"
  },
  "engines": {
    "node": ">=8.5"
  },
  "scripts": {
    "build": "npm run build:lib && npm run build:bundles",
    "build:lib": "babel src -d build",
    "build:bundles": "rollup -c rollup.config.js",
    "install:clear": "rm -rf node_modules",
    "lint": "eslint --fix",
    "prepublishOnly": "npm run build",
    "test": "nyc --reporter=html --all mocha --exit --require @babel/register 'test/**/**.test.js'",
    "test:watch": "npm test --watch"
  },
  "keywords": [
    "form",
    "lit",
    "service",
    "react",
    "reactive",
    "validator",
    "validators",
    "zen",
    "zensen"
  ],
  "devDependencies": {
    "@babel/cli": "^7.8.3",
    "@babel/core": "^7.8.3",
    "@babel/node": "^7.8.3",
    "@babel/preset-env": "^7.8.3",
    "@babel/register": "^7.8.3",
    "@rollup/plugin-babel": "^5.3.1",
    "@rollup/plugin-node-resolve": "^11.2.1",
    "@rollup/plugin-commonjs": "^21.0.1",
    "chai": "^4.2.0",
    "eslint": "^5.16.0",
    "eslint-config-standard": "^12.0.0",
    "eslint-plugin-html": "^5.0.3",
    "eslint-plugin-import": "^2.17.1",
    "eslint-plugin-no-only-tests": "^2.3.0",
    "eslint-plugin-node": "^8.0.1",
    "eslint-plugin-promise": "^4.1.1",
    "eslint-plugin-standard": "^4.0.0",
    "mocha": "^6.1.3",
    "nyc": "^15.1.0",
    "rollup": "^2.79.1",
    "sinon": "^8.1.0",
    "sinon-chai": "^3.4.0"
  },
  "dependencies": {
    "validator": "^13.1.1"
  }
}
